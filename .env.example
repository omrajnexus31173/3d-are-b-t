# ---------------------------------------------------------------------------
# BHARAT-AV environment variables
#
# Two services, two sets of variables. Only VITE_* values reach the browser.
# Never prefix a secret with VITE_ — anything prefixed is compiled into the
# public bundle.
# ---------------------------------------------------------------------------

# ===== FRONTEND (Vercel) ===================================================
# REQUIRED in production. Public URL of the signalling service, absolute,
# no trailing slash. Compiled in at BUILD time, so set it before deploying.
#
# A production build with this unset fails loudly (SignalConfigError) rather
# than falling back to the Vite dev proxy path, which 404s on a static host.
#
# Use the bare origin. The app appends /signal itself; a value that already
# ends in /signal is accepted and normalised, so both of these are equivalent:
#   https://bharat-av-signal.onrender.com
#   https://bharat-av-signal.onrender.com/signal
# Do NOT add a route such as /health or /session.
VITE_SIGNAL_URL=https://bharat-av-signaling.onrender.com

# ===== SIGNALLING SERVICE (Render) =========================================
# Set these on the signalling service only. None are read by the frontend.

# PORT is injected by Render automatically. Locally, SIGNAL_PORT is used.
# SIGNAL_PORT=8787

# REQUIRED when NODE_ENV=production. Exact frontend origin(s), comma-separated,
# no trailing slash. The server FAILS CLOSED (503) if this is missing in
# production, and rejects any origin not listed here with 403.
ALLOWED_ORIGINS=https://your-app.vercel.app

# Trust X-Forwarded-For for client IPs. Enable ONLY when a proxy you control
# appends the real peer address (Render does). The right-most entry is used,
# because the left-most is client-supplied and spoofable.
# TRUST_PROXY=true

# Session and socket policy
# SIGNAL_TTL_MS=600000
# SIGNAL_IDLE_MS=300000
# SIGNAL_MAX_SESSIONS=200
# SIGNAL_AUTH_TIMEOUT_MS=5000
# SIGNAL_WS_CONN_LIMIT=20
# SIGNAL_WS_CONN_WINDOW_MS=60000

# STUN (defaults are public Google STUN servers)
# STUN_URLS=stun:stun.l.google.com:19302

# TURN — required for phone-on-mobile-data connectivity. SERVER-SIDE ONLY:
# never expose these to the frontend. The server hands them to the browser
# only after a session is created.
# TURN_URL=turn:turn.yourdomain.com:3478
# TURN_USERNAME=...
# TURN_CREDENTIAL=...
